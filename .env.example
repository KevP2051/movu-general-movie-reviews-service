# Database Configuration (desde docker-compose de infra)
DB_HOST=postgres  # Nombre del servicio en docker-compose
DB_PORT=5432
DB_NAME=movu_db
DB_USER=movu
DB_PASSWORD=movudbpassword
DB_SCHEMA=general_movie_reviews_service

# Server Configuration
PORT=3001
NODE_ENV=development

# TMDb API Configuration
# Obtén tu API key en: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Redis Configuration (Cache)
# Nota: Necesitas agregar Redis al docker-compose de infra
REDIS_HOST=redis  # Nombre del servicio en docker-compose
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration (Message Queue - desde docker-compose de infra)
KAFKA_BROKERS=kafka:29092  # Puerto interno de Kafka en Docker
