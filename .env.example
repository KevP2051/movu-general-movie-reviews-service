# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=movu_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_SCHEMA=general_movie_reviews_service

# Server Configuration
PORT=3001
NODE_ENV=development

# Gateway Configuration
CORS_ORIGIN=http://localhost:8080
# Para Docker: CORS_ORIGIN=http://movu-api-gateway:8080

# JWT Configuration (for reference, gateway validates the token)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# TMDb API Configuration
# Obtén tu API key en: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
